    {
      "name": "01 Public endpoints",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 200\",()=>pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Menu without JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/menu",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 200\",()=>pm.expect([200]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Queue order without JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/orders/queue",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerName\": \"Test Customer\",\n  \"selectedItemSKUs\": [\n    \"part3-item-001\"\n  ],\n  \"totalPrice\": 25,\n  \"orderTimestamp\": \"2026-11-10T10:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected status 202\",()=>pm.expect([202]).to.include(pm.response.code));"
                ]
              }
